# Hermes tokens — the only per-person part of this config.
#
#   cp tokens.env.example tokens.env && chmod 600 tokens.env
#   <fill in the values you have>
#   ./install.sh
#
# Same names as the opencode installer's tokens.env, so one file works for both
# (cp ~/git/opencode/tokens.env . is fine).
#
# tokens.env is git-ignored: never commit it. install.sh copies each value into
# ~/.hermes/.env (mode 600) and config.yaml refers to them by name, so no token
# ever appears in config.yaml.
#
# Leave a value empty if you don't have that token:
#   - an empty LLM key drops that model from the start of the fallback chain,
#   - an empty MCP token disables that MCP server.
# Re-running install.sh with an empty value keeps the token already in ~/.hermes/.env.
# No quotes needed; everything after the first "=" is the value.

# ── LLM gateways ──────────────────────────────────────────────────────────────
# Your personal key for the Fortinet fos-ai gateway (https://fos-ai.fortinet.com/v1).
# Primary model: deepseek-v4.1-flash (the first model of its prefer list in
# config/model-preferences.yaml that answers; since 2026-10-19 DeepSeek V4.1 Flash).
FOS_AI_API_KEY=

# A second fos-ai key for fallback 1 (glm-5.3, or the next model of its prefer list
# that answers), for example a project token with its own budget. Empty = reuse FOS_AI_API_KEY.
FOS_AI_FALLBACK_API_KEY=

# Key for the internal Qwen gateway (https://releaseqa-aiserver.corp.fortinet.com/v1).
# Fallbacks 2 and 3.
LOCAL_QWEN_API_KEY=

# ── MCP servers ───────────────────────────────────────────────────────────────
# Mantis (fos-qa-assistant on releaseqa-portal): your personal API token, the
# same one you paste into the Log Intelligence AI Assistant under "My connections".
MANTIS_MCP_TOKEN=

# Jenkins (releaseqa-stackjenkins): user:apitoken
# (Jenkins → your user name → Configure → API Token → Add new token).
JENKINS_MCP_TOKEN=

# Log Intelligence MCP: a per-person API key (starts with limcp_) issued by the
# Log Intelligence admin. It is shown once when it is created.
LOGINTEL_MCP_KEY=

# Image server MCP (releaseqa-imageserver:8091): build sync status, image paths,
# GA and release tags. A shared read-only key (starts with imgmcp_) from the
# image server owner; the same value the Log Intelligence server uses.
IMAGE_SERVER_MCP_API_KEY=

# ── Telegram (optional) ───────────────────────────────────────────────────────
# Chat with Hermes from your phone. Leave all three empty to skip; install.sh then
# leaves the gateway alone. See docs/guides/telegram.md.
# 1. In Telegram, message @BotFather: /newbot -> it answers with a token like
#    123456789:ABCdefGHIjklMNOpqrSTUvwxYZ
TELEGRAM_BOT_TOKEN=

# 2. Your numeric Telegram user ID (not your @username): message @userinfobot.
#    Comma-separated for several people. Only these IDs may talk to the bot.
TELEGRAM_ALLOWED_USERS=

# 3. Where scheduled-task results and notices are sent. Empty = the single ID above.
TELEGRAM_HOME_CHANNEL=

# ---- Which host THIS Hermes runs on (config/hosts.yaml key). Configurable, not guessed: ----
# resolution order is  install.sh --host <name>  >  HERMES_HOST here  >  auto-detect by hostname / IP.
# install.sh writes it to ~/.hermes/.env too, so the agent can `echo $HERMES_HOST`.
HERMES_HOST=

# ---- Host login credentials for config/hosts.yaml ----
# NAME = host key in hosts.yaml, upper-cased. install.sh (§13.7, not yet implemented) merges
# these into ~/.hermes/.env and writes ~/.ssh/config.d/hermes_hosts so `ssh <name>` works.
# SSH: prefer _KEY (path to a private key); _PASSWORD only where a key is impossible.
# RDP: for xfreerdp/remmina; _DOMAIN is the AD domain when the login is a domain account.

# office1 — this workstation, Ubuntu, AD domain FORTINET-US.COM (from `realm list`), 172.19.136.41
# office1/2/3 share one AD login: SSH and RDP passwords are the same on all three
SSH_OFFICE1_USER=
SSH_OFFICE1_KEY=
SSH_OFFICE1_PASSWORD=
SSH_OFFICE1_PORT=
RDP_OFFICE1_USER=
RDP_OFFICE1_PASSWORD=
RDP_OFFICE1_DOMAIN=
RDP_OFFICE1_PORT=

# office2 — laptop, Windows, 172.19.136.141 (RDP is the primary login; SSH only if OpenSSH Server is enabled)
SSH_OFFICE2_USER=
SSH_OFFICE2_KEY=
SSH_OFFICE2_PASSWORD=
SSH_OFFICE2_PORT=
RDP_OFFICE2_USER=
RDP_OFFICE2_PASSWORD=
RDP_OFFICE2_DOMAIN=
RDP_OFFICE2_PORT=

# office3 — new laptop, Windows, 172.19.136.147 (RDP is the primary login; SSH only if OpenSSH Server is enabled)
SSH_OFFICE3_USER=
SSH_OFFICE3_KEY=
SSH_OFFICE3_PASSWORD=
SSH_OFFICE3_PORT=
RDP_OFFICE3_USER=
RDP_OFFICE3_PASSWORD=
RDP_OFFICE3_DOMAIN=
RDP_OFFICE3_PORT=

# cdn — fortistackrobot, 10.96.234.39
SSH_CDN_USER=
SSH_CDN_KEY=
SSH_CDN_PASSWORD=
SSH_CDN_PORT=
RDP_CDN_USER=
RDP_CDN_PASSWORD=
RDP_CDN_DOMAIN=          # no domain: local account
RDP_CDN_PORT=

# log_intel_server — fortistackrobot, 10.96.234.80
SSH_LOG_INTEL_SERVER_USER=
SSH_LOG_INTEL_SERVER_KEY=
SSH_LOG_INTEL_SERVER_PASSWORD=
SSH_LOG_INTEL_SERVER_PORT=
RDP_LOG_INTEL_SERVER_USER=
RDP_LOG_INTEL_SERVER_PASSWORD=
RDP_LOG_INTEL_SERVER_DOMAIN=   # local account (fosqa), no domain
RDP_LOG_INTEL_SERVER_PORT=

# guiauto1 — lab GUI automation host, 172.18.57.7
SSH_GUIAUTO1_USER=
SSH_GUIAUTO1_KEY=
SSH_GUIAUTO1_PASSWORD=
SSH_GUIAUTO1_PORT=
RDP_GUIAUTO1_USER=
RDP_GUIAUTO1_PASSWORD=
RDP_GUIAUTO1_DOMAIN=
RDP_GUIAUTO1_PORT=

# fgt1 — lab FortiGate, 172.18.62.232 (FortiOS CLI over ssh; no RDP, GUI is https://172.18.62.232)
SSH_FGT1_USER=
SSH_FGT1_KEY=
SSH_FGT1_PASSWORD=
SSH_FGT1_PORT=
FGT1_GUI_URL=
FGT1_REST_TOKEN=
